none:#7a7f8c;--gold:#f2c230;color-scheme:light dark}
@media (prefers-color-scheme:dark){:root{--bg:#121a2c;--card:#1b2540;--ink:#f1eee4;--line:#33405f}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,"Segoe UI",sans-serif}
.wrap{max-width:960px;margin:auto;padding:20px 16px 40px}
h1{font-size:2.4rem;margin:0}
.stats{color:var(--present);font-weight:700}
form,.card{background:var(--card);border:1.5px solid var(--line);border-radius:12px;padding:16px}
form{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
label{display:flex;flex-direction:column;gap:4px;font-weight:600}
input{font:inherit;padding:8px;border:1.5px solid var(--line);border-radius:8px;
background:var(--bg);color:var(--ink)}
.full{grid-column:1/-1}
button{font:inherit;font-weight:700;padding:6px 12px;border:1.5px solid var(--ink);
border-radius:8px;background:var(--gold);color:#1b2742;cursor:pointer}
button.on{background:var(--ink);color:var(--card)}
.err{color:var(--absent)}
.tools{display:flex;flex-wrap:wrap;align-items:flex-end;gap:10px;margin:20px 0 12px}
.tools .grow{flex:1;min-width:180px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px}
.card{border-top:8px solid var(--none)}
.card.P{border-top-color:var(--present)}
.card.A{border-top-color:var(--absent)}
.card h3{margin:4px 0}
.card p{margin:4px 0}
.ok{color:var(--present);font-weight:700}
.low{color:var(--absent);font-weight:700}
